#
# 🧩 CUSTOM CONFIG LAYER: timelm on top of kona-perf_defconfig
#
# This file adds LGE-specific features missing in upstream kona-perf_defconfig.
# Apply via:
#   cp arch/arm64/configs/vendor/kona-perf_defconfig .config
#   cat custom.config >> .config
#   make olddefconfig
#

# ==============================================================================
# 🔧 HARDWARE & PLATFORM
# ==============================================================================

# ✅ Device model detection and bootloader integration
CONFIG_MACH_KONA_TIMELM=y
CONFIG_MACH_KONA_TIMELM_LAO_COM=y
# NOTE: Required for LGE dual-SKU support

CONFIG_LGE_HANDLE_PANIC=y
# DIFF: Not in kona-perf_defconfig
# WHY: Needed for lge_get_download_mode(), used in msm-poweroff.c, printk.c
# ❌ DO NOT REMOVE — build fails without it

CONFIG_LGE_BOOTLOADER_LOG=y
CONFIG_LGE_BOOTLOADER_TIME_CHECKER=y
# DIFF: OEM-specific boot diagnostics
# TIP: Helps debug slow boots or download-mode issues

CONFIG_LGE_ONE_BINARY_SKU=y
# DIFF: LGE-only; enables unified firmware image handling
# WHY: Needed if using one kernel for multiple regions/models

CONFIG_LGE_DUAL_SCREEN=y
CONFIG_LGE_DISPLAY_DIMMING_BOOT_SUPPORT=y
# DIFF: LGE foldable/display tuning
# WHY: Controls brightness behavior during boot animation


# ==============================================================================
# 🖱️ TOUCH & INPUT
# ==============================================================================

CONFIG_LGE_TOUCH_CORE=y
CONFIG_LGE_TOUCH_CORE_QCT=y
CONFIG_LGE_TOUCH_FW_PATH="touch/timelm"
# DIFF: Path to touch firmware; must match layout in /vendor
# WHY: Required for proper touch initialization

CONFIG_LGE_TOUCH_PEN=y
CONFIG_LGE_TOUCH_DEX=y
CONFIG_LGE_TOUCH_USE_PANEL_NOTIFY=y
CONFIG_LGE_TOUCH_LGSIC_SW42902=y
# DIFF: Stylus (SPen), DEX mode, panel sync
# WHY: Needed for full stylus and UI responsiveness

CONFIG_SAR_ALMF04_C2_C3_12QFN=y
CONFIG_SENSORS_TCS3407=y
# DIFF: Proximity & ambient light sensors
# WHY: Used in auto-brightness and call proximity detection

CONFIG_INPUT_FINGERPRINT=y
CONFIG_BBK_ET713=y
CONFIG_SECURE_TOUCH=y
# DIFF: Fingerprint driver and secure input isolation
# WHY: Required for biometric auth and secure UI (e.g., banking apps)

CONFIG_TSPDRV=y
CONFIG_VIB_DW7800=y
# DIFF: Touch feedback vibration
# WHY: Provides haptic feedback on touch events

CONFIG_LGE_HID_STYLUS_PEN=y
# DIFF: HID over USB/Bluetooth stylus support
# WHY: For external styluses or accessories


# ==============================================================================
# 🔋 POWER & CHARGING
# ==============================================================================

CONFIG_LGE_PM=y
CONFIG_LGE_PM_PRM=y
CONFIG_LGE_PM_VENEER_PSY=y
CONFIG_LGE_PM_SMPL_COUNTER=y
CONFIG_LGE_PM_DEBUG=y
# DIFF: LGE power management framework
# WHY: Manages battery charging, thermal, and PMIC interaction

CONFIG_CHARGER_IDTP9222=y
# DIFF: Wireless charging IC
# WHY: Required for WLC (Wireless Charging) functionality

CONFIG_THERMAL_EMULATION=y
CONFIG_LGE_VIRTUAL_SENSOR=y
# DIFF: Debug-only thermal simulation
# WARN: May cause fake throttling — disable in production


# ==============================================================================
# 🔌 USB & GADGETS
# ==============================================================================

CONFIG_LGE_USB=y
CONFIG_LGE_USB_GADGET=y
CONFIG_LGE_USB_DEBUGGER=y
CONFIG_LGE_USB_EMBEDDED_BATTERY=y
CONFIG_LGE_USB_SBU_SWITCH=y
CONFIG_LGE_USB_MOISTURE_DETECTION=y
CONFIG_LGE_USB_MOISTURE_DETECTION_NO_UX=y
CONFIG_LGE_USB_MOISTURE_DETECTION_USB_EN=y
CONFIG_LGE_USB_DS_DIRECT_SVID=y
CONFIG_LGE_USB_SUPPORT_SUPERSPEED=y
# DIFF: Full USB Type-C + moisture + SBU + debug features
# WHY: Critical for USB connectivity, fastboot, and safety checks

CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
# DIFF: Legacy USB host support (not enabled in GKI)
# WHY: Needed if using USB OTG with older devices

CONFIG_DUAL_ROLE_USB_INTF=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_PPP_FILTER=y
CONFIG_PPP_MULTILINK=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_SYNC_TTY=y
CONFIG_USB_UAS=y
# DIFF: USB networking (RNDIS, PPP, UAS)
# WHY: For reverse tethering, serial over USB, external SSDs


# ==============================================================================
# 📡 CONNECTIVITY
# ==============================================================================

CONFIG_LGE_NFC=y
CONFIG_LGE_NFC_PN553=y
CONFIG_LGE_NFC_SET_IRQ_WAKEUP=y
CONFIG_NFC_CXD22XX=m
CONFIG_NFC_CXD22XX_RST=y
CONFIG_NFC_CXD22XX_SERVICE_MODE=y
# DIFF: NFC chip support (PN553 + CXD22XX)
# WHY: Required for LG Pay, SmartShare, etc.

CONFIG_WIL6210=m
CONFIG_MSM_11AD=m 
CONFIG_QCA_CLD_WLAN=m
CONFIG_DVB_MPQ=y 
CONFIG_DVB_MPQ_DEMUX=m 
CONFIG_DVB_MPQ_SW=y 
# DIFF: mmWave, WiGig, DVB-T tuner
# WARN: May increase boot time or memory use — consider removing if unused


# ==============================================================================
# 💾 FILESYSTEMS
# ==============================================================================

CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_ECRYPT_FS=y
CONFIG_ECRYPT_FS_MESSAGING=y
CONFIG_UNICODE=y
# DIFF: OTG USB drive support + encrypted home directories
# WHY: Allows mounting exFAT/NTFS drives via USB OTG
# TIP: NTFS_RW requires proper license handling


# ==============================================================================
# 🧠 MEMORY & CMA
# ==============================================================================

CONFIG_CMA_PINPAGE_MIGRATION=y
CONFIG_MIGRATE_HIGHORDER=y
CONFIG_HIGHORDER_PAGES=256000
# DIFF: Aggressive CMA for camera/display
# WARNING: May cause memory fragmentation
# TUNE: Adjust HIGHORDER_PAGES based on available RAM (256k pages = ~1GB)


# ==============================================================================
# ⚙️ SCHEDULER
# ==============================================================================

CONFIG_SCHED_CAS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_MULTI_STEP_BOOST=n
CONFIG_LGE_SCHED_USERSPACE_FASTSWITCH_SWITCH=y
CONFIG_LGE_SCHED_SHOW_PSI_MEM_TRIGGER_LOG=y
# DIFF: LGE's CAS (CPU Activity Scaling) + autogrouping
# WHY: Improves responsiveness under load
# WARN: Not compatible with EAS (Energy Aware Scheduling) — disable if using GKI sched

# CPU input boost
CONFIG_CPU_BOOST=n

# Scheduler boost LG
CONFIG_SCHED_MULTI_STEP_BOOST=n

# CAS boost LG
CONFIG_SCHED_CAS=n


# ==============================================================================
# 🌐 NETWORKING
# ==============================================================================

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_LIA=y
CONFIG_TCP_CONG_OLIA=y
CONFIG_TCP_CONG_WVEGAS=y
# DIFF: Advanced congestion control (LIA = Low Extra Delay Background)
# WHY: Better performance on high-latency networks
# NOTE: BIC was removed — these are modern replacements

# CONFIG_MPTCP=y  # ❌ Disabled: may conflict with carrier APNs
CONFIG_MPTCP_PM_ADVANCED=y
CONFIG_MPTCP_FULLMESH=y
CONFIG_MPTCP_NDIFFPORTS=y
# CONFIG_MPTCP_BINDER=y  # ❌ Optional
CONFIG_MPTCP_SCHED_ADVANCED=y
CONFIG_MPTCP_ROUNDROBIN=y
# CONFIG_LGP_DATA_TCPIP_MPTCP=y  # ❌ Optional
# WHY: MPTCP allows bonding LTE/WiFi — keep only if required
#
CONFIG_XFRM_SUB_POLICY=y
CONFIG_XFRM_FRAG_ESP_BEFORE_TUNNEL_ENC=y
# DIFF: IPsec fragmentation handling
# WHY: Needed for some corporate or legacy VPNs

CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NF_CT_NETLINK_HELPER=y
CONFIG_NETFILTER_NETLINK_GLUE_CT=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_LG_VPN_V38=y
CONFIG_VPNCLIENT_SECURITY=m
CONFIG_NF_NAT_IPV6=y
CONFIG_NET_SCH_CBQ=y
CONFIG_NET_SCH_HFSC=y
CONFIG_NET_SCH_RED=y
CONFIG_NET_SCH_SFB=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_SCH_TEQL=y
CONFIG_NET_SCH_GRED=y
CONFIG_NET_SCH_DSMARK=y
CONFIG_NET_SCH_DRR=y
CONFIG_NET_SCH_MQPRIO=y
CONFIG_NET_SCH_CHOKE=y
CONFIG_NET_SCH_QFQ=y
# DIFF: QoS, traffic shaping, advanced netfilter
# WHY: For enterprise, gaming, or bandwidth shaping
# WARN: Increases kernel size and complexity


# ==============================================================================
# 🐞 DEBUG & LOGGING
# ==============================================================================

CONFIG_PRINTK_TIMESPEC=y
CONFIG_PRINTK_PROCESS=y
CONFIG_PRINTK_EXTRA_LOGBUF_SHIFT=20
CONFIG_LEAVE_INITLOG=y
CONFIG_SECURITY_DMESG_RESTRICT=n
# DIFF: Enhanced logging with timestamps and process info
# WHY: Easier debugging of boot issues
# TIP: log_buf_len = 4MB (1<<20)

CONFIG_TRACE_GPU_MEM=y
CONFIG_ION_DEBUGGING_PROCFS=y

# DIFF: GPU memory tracing
# WHY: Debug GPU leaks or display issues

CONFIG_MSM_DEBUGCC_KONA=y
CONFIG_QCOM_MINIDUMP=y
CONFIG_QCOM_RTB=y
CONFIG_QCOM_RTB_SEPARATE_CPUS=y
CONFIG_MHI_LGE_PRINT_SFR=y
CONFIG_LGE_ESOC_LOG_CONTROL=y
CONFIG_LGE_LOG_FOR_UL_STALL=y
# CONFIG_LGE_FORCE_SSR_ON_CHARGE_LOGO=y  # ❌ Dangerous — can brick recovery
CONFIG_LGE_COREDUMP_FORMAT=y
CONFIG_LGE_REPORT_ONCE=y
CONFIG_LGE_HSWAP=y
CONFIG_LGE_UDP_RCV_BUF_COUNT_PATCH=y
CONFIG_LGE_DATA_SET_OPERATOR_FOR_IPV6=y
CONFIG_LGE_DATA_TCPIP_DISABLE_ACCEPT_RA_DEFRTR=y
CONFIG_LGE_WIRELESS_SCAN_PATCH=y
CONFIG_LGE_WORKQUEUE_WATCHDOG_TUNE=y
CONFIG_LGE_MORE_IOMMU_TRACE=y
# DIFF: LGE-specific debug tools
# WARN: Many increase log spam or memory use — disable in final builds


# ==============================================================================
# 🔐 SECURITY
# ==============================================================================

CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=0
# DIFF: Mandatory access control
# WHY: Complements SELinux for app sandboxing
# WARN: Must have userspace policy loaded

#CONFIG_SECURITY_SMACK=y  # ❌ Avoid — conflicts with SELinux unless required
CONFIG_FORTIFY_SOURCE=y  # ❌ Heavy runtime checks — dev only
# CONFIG_PANIC_ON_OOPS is not set   # ❌ Can cause boot loops — use with care
CONFIG_DEBUG_LIST=n      # ❌ Expensive — use only for debugging


# ==============================================================================
# 🧩 MISCELLANEOUS
# ==============================================================================

# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-rofikkerneldev-Sky510"
# DIFF: Appends git hash to kernel version
# WARN: Breaks GKI signing — OK for custom kernels

CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_ARM64_CRYPTO=y
# DIFF: Performance & crypto acceleration
# WHY: LSE improves atomic performance on Cortex-A55/A76

CONFIG_CHR_DEV_SCH=y
CONFIG_MSM_RDBG=m
CONFIG_WIGIG_SENSING_SPI=m
CONFIG_FB_ARMCLCD=y
CONFIG_LOGO=y
CONFIG_HID_QVR=y
CONFIG_MMC_TEST=y
CONFIG_EDAC_KRYO_ARM64_PANIC_ON_UE=y
CONFIG_RTC_DRV_QPNP=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_FRAME_WARN=4096
CONFIG_RCU_PANIC_ON_STALL=1
CONFIG_LGE_SUPPRESS_DMA_PRINT=y
CONFIG_LGE_SUPPRESS_QSEE_LOG=y
CONFIG_LGE_CNSS_FIRMWARE_OVERRIDE=y
CONFIG_LGE_DIAG_BYPASS=y
CONFIG_LGE_DUAL_QFUSE=y
CONFIG_QCOM_LLCC_PERFMON=m
CONFIG_LGE_MME_BUS=y
CONFIG_LGE_MME_BOOST=y
CONFIG_LGE_MME_BOOST_EBI=y
CONFIG_LGE_MME_PM_QOS_DMA_LATENCY=y
CONFIG_NVM=y
CONFIG_NVM_PBLK=y
CONFIG_INPUT_MOUSE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM_WRITEBACK=y
# DIFF: Various LGE/Qualcomm debug, storage, and tuning features
# WHY: Enable only if actively used
# TIP: NVM_PBLK needed for OpenChannel SSDs

#unstrict build
#CONFIG_CC_WERROR is not set

# fix button volume
# CONFIG_MSM_QBT_HANDLER is not set

# fuse Bpf
CONFIG_DAX=y
CONFIG_CUSE=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_BPF=y

# 16K Pages experimental
#CONFIG_ARM64_16K_PAGES=y

# erofs support
CONFIG_EROFS_FS_ZIP=y
CONFIG_CRYPTO_LZ4=y
CONFIG_LZ4_DECOMPRESS=y

# Module signing
CONFIG_MODULE_SIG=n
# CONFIG_MODULE_SIG_ALL is not set
# CONFIG_MODULE_SIG_FORCE is not set

# Trusted keys
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# LG HIDDEN CONFIG
CONFIG_LGE_BOOTLOADER_LOG=y

#test 
# CONFIG_LGE_DM_VERITY_RECOVERY is not set
# CONFIG_ION_DEBUGGING_LGE_EXTN_DEBUGFS is not set