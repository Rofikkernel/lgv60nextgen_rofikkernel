# erofs
CONFIG_EROFS_FS=y

# Patch from lineageOS SM8250 QCOM
# CONFIG_RSEQ is not set
# CONFIG_ARM64_CRYPTO is not set
CONFIG_WIREGUARD=y
CONFIG_DM_BOW=y

# SHOULD DISABLED
CONFIG_MMC_TEST=n
CONFIG_ECRYPT_FS=n
CONFIG_ECRYPT_FS_MESSAGING=n

CONFIG_DVB_MPQ=n
CONFIG_DVB_MPQ_DEMUX=n
CONFIG_DVB_MPQ_SW=n

CONFIG_MSM_11AD=n

CONFIG_MEMORY_HOTPLUG=n
CONFIG_MEMORY_HOTPLUG_DEFAULT_ONLINE=n
CONFIG_MEMORY_HOTPLUG_MOVABLE_NODE=n
CONFIG_OVERRIDE_MEMORY_LIMIT=n
#CONFIG_HOTPLUG_SIZE_BITS is not set
CONFIG_MEMORY_HOTREMOVE=n
CONFIG_QCOM_MEM_OFFLINE=n

# improve boottime
# CONFIG_VT is not set
CONFIG_HID_QVR=n

CONFIG_EXT4_ENCRYPTION=n
CONFIG_FS_ENCRYPTION=y

# go bandwidth limiting
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_BPF=y

# playstation supporting
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y

CONFIG_EDAC_KRYO_ARM64_PANIC_ON_UE=n

# enable debug
CONFIG_CRYPTO_DRBG_HASH=y
CONFIG_CRYPTO_DRBG_CTR=y

# unused
CONFIG_WIGIG_SENSING_SPI=n
CONFIG_WIL6210=n
CONFIG_QCOM_LLCC_PERFMON=n

CONFIG_CRYPTO_LZ4=y

# disable unused app armor
CONFIG_SECURITY_APPARMOR=n
CONFIG_AUDIT=y

CONFIG_BUILD_ARM64_DT_OVERLAY=y

CONFIG_USERFAULTFD=y


CONFIG_BPF_LSM=y
CONFIG_BPF_PRELOAD=y

# target kernel 6
CONFIG_GKI_HIDDEN_GPU_CONFIGS=y
CONFIG_XFRM_MIGRATE=y
CONFIG_CRYPTO_CHACHA20POLY1305=y

# smack
CONFIG_SECURITY_SMACK=n
CONFIG_SECURITY_NETWORK=y



